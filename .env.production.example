# Copy to `.env` next to docker-compose.yml and fill in EVERY value. Never commit `.env`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Public address ---------------------------------------------------------
# Exact origin users type in the browser (scheme + host, no trailing slash).
APP_ORIGIN=https://app.example.com
# Hostname only, for automatic HTTPS (docker compose --profile tls).
APP_DOMAIN=app.example.com
# Host port for the web app when NOT using the tls profile.
WEB_PORT=3000

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=uss_app
MYSQL_DATABASE=urbansecurity

# --- API behaviour -----------------------------------------------------------
JWT_EXPIRES_IN=12h
# Set to 1 when using the tls profile (Caddy -> API). Keep 0 if nothing trusted sits in front
# of the API: X-Forwarded-For is then ignored, so client IPs can never be spoofed.
TRUST_PROXY=1
LOG_LEVEL=info
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
ENABLE_SETUP_REGISTRATION=false

# --- Error tracking (optional) ------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Evidence storage ----------------------------------------------------------
# local = Docker volume on this server (back it up!). s3 = private bucket (recommended).
STORAGE_DRIVER=local
# Cloudflare R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Data retention (npm run retention) --------------------------------------
GPS_RETENTION_DAYS=365
# AUDIT_RETENTION_DAYS=2555
