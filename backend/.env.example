# ---------------------------------------------------------------------------
# Urban Security Solutions API configuration.
# The server validates these at startup and REFUSES TO BOOT if anything is unsafe.
# ---------------------------------------------------------------------------

# Database Connection (Prisma). Use a dedicated DB user with only the privileges the app needs.
DATABASE_URL="mysql://user:password@localhost:3306/urbansecurity"

# Signing key for session tokens. Minimum 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be the SAME value in frontend/.env.local (used by the Next.js route guard).
JWT_SECRET=""

# Session lifetime (s/m/h/d). 12h covers a guard shift.
JWT_EXPIRES_IN=12h

# Server
PORT=5000
HOST=0.0.0.0

# Secure by default: anything other than "development" or "test" runs in PRODUCTION mode
# (HTTPS-only cookies, strict CORS, HSTS, generic error messages).
NODE_ENV=development

# Comma-separated list of allowed frontend origins. REQUIRED in production.
# localhost/LAN origins are additionally allowed only when NODE_ENV=development.
# Example: CORS_ORIGINS=https://app.urbansecurity.com
CORS_ORIGINS=

# Optional: shared cookie domain when frontend and API are on different subdomains of the
# same site (e.g. ".urbansecurity.com"). Leave unset for local/single-host setups.
COOKIE_DOMAIN=

# Number of reverse proxies / load balancers in front of the API (0 = none).
# Needed so rate limiting sees real client IPs.
TRUST_PROXY=0

# One-time first-admin bootstrap endpoint (POST /api/auth/register). Keep false; prefer the
# seed script below. Only works while the database has no users at all.
ENABLE_SETUP_REGISTRATION=false

# Used ONLY by `npm run seed` to create the first admin. Remove after seeding.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
