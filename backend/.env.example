# Database Connection (Prisma)
DATABASE_URL="mysql://user:password@localhost:3306/urbansecurity"

# Security Key for Login Tokens — generate a long random value, never reuse this placeholder.
JWT_SECRET="change_this_to_a_long_random_secret"

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS (LAN/localhost origins are always allowed).
# Example: CORS_ORIGINS=https://admin.urbansecurity.com,https://guard.urbansecurity.com
CORS_ORIGINS=

# Optional: shared cookie domain when the frontend and backend run on different subdomains of the
# same site in production (e.g. ".urbansecurity.com"). Leave unset for local/single-host setups.
COOKIE_DOMAIN=
