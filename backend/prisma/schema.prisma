generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Defined Enums for strict type safety
enum Role {
  ADMIN
  GUARD
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum IncidentSeverity {
  
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

// 2. Hardened User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatarUrl String?  @db.LongText
  role      Role     @default(GUARD) // Uses the Enum instead of String
  status    UserStatus @default(ACTIVE)

  // Relations
  managedSites Site[]    @relation("SiteManager")
  assignedShifts Shift[]
  incidents      Incident[]
  reports        Report[]
  shiftHandoverIns  Shift[] @relation("ShiftCheckInFrom")
  shiftHandoverOuts Shift[] @relation("ShiftCheckOutTo")
  clientSites    ClientSite[] @relation("ClientSiteAssignments")
  clientInvoices Invoice[] @relation("InvoiceClient")
  issuedInvoices Invoice[] @relation("InvoiceIssuer")

  // Assignment: Each guard can be assigned to one site
  siteId   String?   // Foreign key to Site
  site     Site?     @relation("UserSite", fields: [siteId], references: [id])

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true) // Professional practice: Soft deactivation
}

model Site {
  id          String   @id @default(uuid())
  name        String
  address     String
  location    String?
  latitude    Float?
  longitude   Float?
  geofenceRadiusMeters Int @default(150)

  // Relations
  managerId   String?
  manager     User?    @relation("SiteManager", fields: [managerId], references: [id])
  incidents   Incident[]
  shifts      Shift[]
  users       User[]   @relation("UserSite")
  clientAssignments ClientSite[] @relation("SiteClientAssignments")
  invoices    Invoice[] @relation("SiteInvoices")

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incident {
  id          String           @id @default(uuid())
  title       String
  description String
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus @default(OPEN)
  resolutionDetails String?
  reportedAt DateTime @default(now())
  photoUrls   Json?
  
  // Relations
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  siteId      String
  site        Site             @relation(fields: [siteId], references: [id])

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id          String      @id @default(uuid())
  startTime   DateTime
  endTime     DateTime?
  status      ShiftStatus @default(SCHEDULED)
  checkedInAt DateTime?
  checkedOutAt DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?

  // Relations
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  siteId      String
  site        Site        @relation(fields: [siteId], references: [id])
  reports     Report[]

  checkInFromUserId String?
  checkInFromUser   User?   @relation("ShiftCheckInFrom", fields: [checkInFromUserId], references: [id])
  checkOutToUserId  String?
  checkOutToUser    User?   @relation("ShiftCheckOutTo", fields: [checkOutToUserId], references: [id])

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientSite {
  clientId   String
  siteId     String
  assignedAt DateTime @default(now())

  client User @relation("ClientSiteAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  site   Site @relation("SiteClientAssignments", fields: [siteId], references: [id], onDelete: Cascade)

  @@id([clientId, siteId])
  @@index([siteId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  description   String        @db.Text
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @db.Char(3)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(ISSUED)
  clientId      String
  siteId        String?
  issuedById    String

  client   User  @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: Restrict)
  site     Site? @relation("SiteInvoices", fields: [siteId], references: [id], onDelete: SetNull)
  issuedBy User  @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, issuedAt])
  @@index([siteId])
}

model Report {
  id          String   @id @default(uuid())
  content     String
  photoUrls   Json?

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
