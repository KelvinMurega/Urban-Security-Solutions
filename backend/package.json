{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:check-drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "seed": "ts-node prisma/seed.ts",
    "retention": "ts-node scripts/retention.ts",
    "reset-password": "ts-node scripts/reset-password.ts"
  },
  "keywords": [],
  "author": "Kelvin Murega",
  "license": "ISC",
  "description": "Urban Security Solutions API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@prisma/client": "5.10.0",
    "@sentry/node": "^9.47.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.2.0",
    "prisma": "5.10.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "private": true,
  "engines": {
    "node": ">=20.11"
  }
}
